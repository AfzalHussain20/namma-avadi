# Namma Avadi — environment configuration
# Copy to .env.local and fill in real values from your Supabase project.

# Public project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://qtgvdltgacrlxyhwjwmw.supabase.co

# Public publishable key (safe to expose; scoped by RLS).
# Replaces the legacy anon key. (NEXT_PUBLIC_SUPABASE_ANON_KEY also works.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key — SERVER ONLY. Never expose in the browser.
# Used only by local scripts (e.g. scripts/create-admin.mjs).
# Replaces the legacy service role key. (SUPABASE_SERVICE_ROLE_KEY also works.)
SUPABASE_SECRET_KEY=

# Public app URL used for links/redirects (localhost for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
